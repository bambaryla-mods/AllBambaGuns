    Armor penetration: 0.30
    TechLevel: Spacer
  -->

	<!-- ==================== PISTOL ==================== -->

	<ThingDef ParentName="BaseBullet">
		<defName>ABG_Bullet_UCPistol</defName>
		<label>advanced charge pistol shot</label>
		<graphicData>
			<texPath>Projectile/Charge/spacer/pistol</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile>
			<damageDef>Bullet</damageDef>
			<damageAmountBase>13</damageAmountBase>
			<armorPenetrationBase>0.30</armorPenetrationBase>
			<speed>70</speed>
		</projectile>
	</ThingDef>

	<ThingDef ParentName="BaseHumanMakeableGun">
		<defName>ABG_Gun_UCPistol</defName>
		<label>advanced charge pistol</label>
		<description>A handy sidearm with low stopping power, making up for it in weight and compactness. This weapon utilizes more precise engineering to eliminate energy losses during the firing process.</description>
		<techLevel>Ultra</techLevel>
		<graphicData>
			<texPath>charge/spacer/pistol</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<soundInteract>Interact_Revolver</soundInteract>
		<thingSetMakerTags>
			<li>RewardStandardQualitySuper</li>
		</thingSetMakerTags>
		<statBases>
			<WorkToMake>35000</WorkToMake>
			<Mass>1.4</Mass>
			<AccuracyTouch>0.75</AccuracyTouch>
			<AccuracyShort>0.65</AccuracyShort>
			<AccuracyMedium>0.48</AccuracyMedium>
			<AccuracyLong>0.35</AccuracyLong>
			<RangedWeapon_Cooldown>1.4</RangedWeapon_Cooldown>
		</statBases>
		<weaponTags>
			<li>SpacerGun</li>
		</weaponTags>
		<weaponClasses>
			<li>RangedLight</li>
		</weaponClasses>
		<tradeTags>
			<li>WeaponRanged</li>
		</tradeTags>
		<costList>
			<Plasteel>45</Plasteel>
			<ComponentSpacer>1</ComponentSpacer>
		</costList>
		<recipeMaker>
			<researchPrerequisite>ABG_Research_AdvancedChargeWeaponry</researchPrerequisite>
			<skillRequirements>
				<Crafting>12</Crafting>
			</skillRequirements>
			<recipeUsers Inherit="False">
				<li>FabricationBench</li>
			</recipeUsers>
			<displayPriority>600</displayPriority>
		</recipeMaker>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>ABG_Bullet_UCPistol</defaultProjectile>
				<warmupTime>0.3</warmupTime>
				<range>25.9</range>
				<soundCast>Shot_ChargeRifle</soundCast>
				<soundCastTail>GunTail_Light</soundCastTail>
				<muzzleFlashScale>9</muzzleFlashScale>
			</li>
		</verbs>
		<tools>
			<li>
				<label>grip</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
			<li>
				<label>barrel</label>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
		</tools>
	</ThingDef>

