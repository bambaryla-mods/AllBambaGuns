<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!--
    Industrial Charge weapons
    Derived from Spacer Charge tier: Damage x0.75, WorkToMake x1.25, Cost x1.10
    Materials: Steel + ComponentIndustrial (one tier below spacer components)
    Crafted at: FabricationBench  |  Research: ChargedShot  |  Crafting skill: 7
    Armor penetration: 0.25
  -->

	<!-- ==================== PISTOL ==================== -->

	<ThingDef ParentName="BaseBullet">
		<defName>ABG_Bullet_ICPistol</defName>
		<label>industrial charge pistol shot</label>
		<graphicData>
			<texPath>Projectile/Charge/industrial/pistol</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile>
			<damageDef>Bullet</damageDef>
			<damageAmountBase>12</damageAmountBase>
			<armorPenetrationBase>0.25</armorPenetrationBase>
			<speed>70</speed>
		</projectile>
	</ThingDef>

	<ThingDef ParentName="BaseHumanMakeableGun">
		<defName>ABG_Gun_ICPistol</defName>
		<label>proto-charge pistol</label>
		<description>A handy sidearm with low stopping power, making up for it in weight and compactness. This weapon uses a crude reverse-engineered implementation of a pulse-charging barrel.</description>
		<techLevel>Industrial</techLevel>
		<graphicData>
			<texPath>charge/industrial/pistol</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<soundInteract>Interact_Revolver</soundInteract>
		<statBases>
			<WorkToMake>4400</WorkToMake>
			<Mass>1.4</Mass>
			<AccuracyTouch>0.7</AccuracyTouch>
			<AccuracyShort>0.6</AccuracyShort>
			<AccuracyMedium>0.45</AccuracyMedium>
			<AccuracyLong>0.3</AccuracyLong>
			<RangedWeapon_Cooldown>1.4</RangedWeapon_Cooldown>
		</statBases>
		<weaponTags>
			<li>IndustrialGunAdvanced</li>
		</weaponTags>
		<weaponClasses>
			<li>RangedLight</li>
		</weaponClasses>
		<costList>
			<Steel>30</Steel>
			<Plasteel>10</Plasteel>
			<ComponentIndustrial>3</ComponentIndustrial>
		</costList>
		<recipeMaker>
			<researchPrerequisite>ABG_Research_ChargeWeaponry_Proto</researchPrerequisite>
			<skillRequirements>
				<Crafting>5</Crafting>
			</skillRequirements>
			<recipeUsers Inherit="False">
				<li>FabricationBench</li>
			</recipeUsers>
			<displayPriority>500</displayPriority>
		</recipeMaker>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>ABG_Bullet_ICPistol</defaultProjectile>
				<warmupTime>0.3</warmupTime>
				<range>24.9</range>
				<soundCast>Shot_ChargeRifle</soundCast>
				<soundCastTail>GunTail_Light</soundCastTail>
				<muzzleFlashScale>9</muzzleFlashScale>
			</li>
		</verbs>
		<tools>
			<li>
				<label>grip</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
			<li>
				<label>barrel</label>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
		</tools>
	</ThingDef>

