<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!--
    Spacer Ballistic (conventional) weapons
    Derived from Industrial Ballistic tier: Damage x1.15, WorkToMake x0.75, Cost x0.85
    Materials: Plasteel + ComponentSpacer (upgraded from industrial steel+CI)
    Crafted at: TableMachining  |  Research: PrecisionRifling  |  Crafting skill: varies
    TechLevel: Spacer
    Note: conventional/spacer/rifle texture is not yet present; add rifle.png to that folder.
  -->

	<!-- ==================== PISTOL ==================== -->

	<ThingDef ParentName="BaseBullet">
		<defName>ABG_Bullet_SBPistol</defName>
		<label>advanced pistol bullet</label>
		<graphicData>
			<texPath>Projectile/Ballistic/spacer/pistol</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile>
			<damageDef>Bullet</damageDef>
			<damageAmountBase>12</damageAmountBase>
			<speed>55</speed>
		</projectile>
	</ThingDef>

	<ThingDef ParentName="BaseHumanMakeableGun">
		<defName>ABG_Gun_SBPistol</defName>
		<label>advanced ballistic pistol</label>
		<description>A handy sidearm with low stopping power, making up for it in weight and compactness. This weapon is an improvement over industrial/modern designs with the use of more advanced, precise techniques and better materials.</description>
		<techLevel>Spacer</techLevel>
		<graphicData>
			<texPath>conventional/spacer/pistol</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<soundInteract>Interact_Autopistol</soundInteract>
		<thingSetMakerTags>
			<li>RewardStandardQualitySuper</li>
		</thingSetMakerTags>
		<statBases>
			<WorkToMake>10000</WorkToMake>
			<Mass>1.1</Mass>
			<AccuracyTouch>0.85</AccuracyTouch>
			<AccuracyShort>0.75</AccuracyShort>
			<AccuracyMedium>0.45</AccuracyMedium>
			<AccuracyLong>0.35</AccuracyLong>
			<RangedWeapon_Cooldown>1.0</RangedWeapon_Cooldown>
		</statBases>
		<weaponTags>
			<li>SpacerGun</li>
		</weaponTags>
		<weaponClasses>
			<li>RangedLight</li>
		</weaponClasses>
		<tradeTags>
			<li>WeaponRanged</li>
		</tradeTags>
		<costList>
			<Steel>30</Steel>
			<Plasteel>5</Plasteel>
			<ComponentIndustrial>3</ComponentIndustrial>
		</costList>
		<recipeMaker>
			<researchPrerequisite>ABG_Research_AdvancedBallisticWeaponry</researchPrerequisite>
			<skillRequirements>
				<Crafting>5</Crafting>
			</skillRequirements>
			<displayPriority>700</displayPriority>
		</recipeMaker>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>ABG_Bullet_SBPistol</defaultProjectile>
				<warmupTime>0.3</warmupTime>
				<range>26.9</range>
				<soundCast>Shot_Autopistol</soundCast>
				<soundCastTail>GunTail_Light</soundCastTail>
				<muzzleFlashScale>9</muzzleFlashScale>
			</li>
		</verbs>
		<tools>
			<li>
				<label>grip</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
			<li>
				<label>barrel</label>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
		</tools>
	</ThingDef>

