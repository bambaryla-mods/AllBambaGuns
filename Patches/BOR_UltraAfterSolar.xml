<?xml version="1.0" encoding="UTF-8"?>
<!-- With Beyond Our Reach, Ultra comes after Solar: each Ultra research requires its Solar counterpart and sits to its right in the tree.
     The Solar/Quasar side of this lives in the BOR_*Research.xml patches that define those projects. -->
<Patch>
    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Beyond Our Reach</li>
            <li>Beyond Our Reach :: Redux</li>
        </mods>
        <match Class="PatchOperationSequence">
            <operations>

                <!-- Glitterworld ballistics have no Solar twin; they just wait for the first BOR weapons research -->
                <li Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="ABG_Research_GlitterBallisticWeaponry"]/prerequisites</xpath>
                    <value><li>BOR_Research_Weapons_I</li></value>
                </li>

                <!-- Ultra launchers. Solar launchers are defined in the launcher BOR patches. -->
                <li Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="ABG_Research_UltraLaunchers"]/prerequisites</xpath>
                    <value><li>ABG_Research_SolarLaunchers</li></value>
                </li>
                <li Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="ABG_Research_UltraLaunchers"]/researchViewX</xpath>
                    <value><researchViewX>5.50</researchViewX></value>
                </li>
                <li Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="ABG_Research_ToxicLaunchers"]/prerequisites</xpath>
                    <value><li>ABG_Research_SolarLaunchers</li></value>
                </li>
                <li Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="ABG_Research_ToxicLaunchers"]/researchViewX</xpath>
                    <value><researchViewX>5.50</researchViewX></value>
                </li>
                <li Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="ABG_Research_ToxicLaunchers"]/researchViewY</xpath>
                    <value><researchViewY>4.40</researchViewY></value>
                </li>

            </operations>
        </match>
    </Operation>
</Patch>
