<Defs>

	<!--
    Ultra Ballistic (conventional) weapons
    Derived from Spacer Ballistic tier: Damage x1.15, WorkToMake x0.75, Cost x0.85
    Materials: Plasteel + ComponentSpacer (same tier, just reduced quantities via efficiency)
    Crafted at: FabricationBench  |  Research: PrecisionRifling  |  Crafting skill: varies
    TechLevel: Ultra
    Note: conventional/ultra/ texture folder is currently empty.
          Add [pistol|rifle|bullpup|dmr|shotgun|lmg|sniper].png to use proper visuals.
  -->

	<!-- ==================== PISTOL ==================== -->

	<ThingDef ParentName="BaseHumanMakeableGun">
		<defName>ABG_Gun_UBPistol</defName>
		<label>glitterworld ballistic pistol</label>
		<description>A handy sidearm with low stopping power, making up for it in weight and compactness. This weapon is the peak of ballistic technology in terms of physics and engineering, it can only be improved with better materials - if any exist.</description>
		<techLevel>Ultra</techLevel>
		<graphicData>
			<texPath>conventional/ultra/pistol</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<soundInteract>Interact_Autopistol</soundInteract>
		<thingSetMakerTags>
			<li>RewardStandardQualitySuper</li>
		</thingSetMakerTags>
		<statBases>
			<WorkToMake>8000</WorkToMake>
			<Mass>1.0</Mass>
			<RangedWeapon_Cooldown>0.34</RangedWeapon_Cooldown>
			<SightsEfficiency>0.90</SightsEfficiency>
			<ShotSpread>0.12</ShotSpread>
			<SwayFactor>0.95</SwayFactor>
			<Bulk>1.60</Bulk>
		</statBases>
		<weaponTags Inherit="False">
			<li>ABG_GlitterGun</li>
			<li>CE_Sidearm</li>
			<li>CE_AI_BROOM</li>
			<li>CE_OneHandedWeapon</li>
		</weaponTags>
		<weaponClasses>
			<li>RangedLight</li>
		</weaponClasses>
		<tradeTags Inherit="False">
			<li>ABG_GlitterGun</li>
		</tradeTags>
		<costList>
			<Steel>20</Steel>
			<Plasteel>15</Plasteel>
			<ComponentIndustrial>1</ComponentIndustrial>
			<ComponentSpacer>1</ComponentSpacer>
		</costList>
		<recipeMaker>
			<researchPrerequisite>ABG_Research_GlitterBallisticWeaponry</researchPrerequisite>
			<skillRequirements>
				<Crafting>7</Crafting>
			</skillRequirements>
			<recipeUsers Inherit="False">
				<li>FabricationBench</li>
			</recipeUsers>
			<displayPriority>800</displayPriority>
		</recipeMaker>
		<verbs>
			<li Class="CombatExtended.VerbPropertiesCE">
				<recoilAmount>2.35</recoilAmount>
				<verbClass>CombatExtended.Verb_ShootCE</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_7x24mmHypersonic_FMJ</defaultProjectile>
				<warmupTime>0.45</warmupTime>
				<range>16</range>
				<soundCast>Shot_Autopistol</soundCast>
				<soundCastTail>GunTail_Light</soundCastTail>
				<muzzleFlashScale>9</muzzleFlashScale>
			</li>
		</verbs>
		<comps>
			<li Class="CombatExtended.CompProperties_AmmoUser">
				<magazineSize>10</magazineSize>
				<reloadTime>3.2</reloadTime>
				<ammoSet>AmmoSet_7x24mmHypersonic</ammoSet>
			</li>
			<li Class="CombatExtended.CompProperties_FireModes">
				<aiUseBurstMode>FALSE</aiUseBurstMode>
				<aiAimMode>Snapshot</aiAimMode>
			</li>
		</comps>
		<tools>
			<li Class="CombatExtended.ToolCE">
				<label>grip</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>2</power>
				<cooldownTime>1.54</cooldownTime>
				<chanceFactor>1.5</chanceFactor>
				<armorPenetrationBlunt>0.555</armorPenetrationBlunt>
				<linkedBodyPartsGroup>Grip</linkedBodyPartsGroup>
			</li>
			<li Class="CombatExtended.ToolCE">
				<label>muzzle</label>
