    Crafted at: TableMachining  |  Research: PrecisionRifling  |  Crafting skill: varies
    TechLevel: Spacer
    Note: conventional/spacer/rifle texture is not yet present; add rifle.png to that folder.
  -->

	<!-- ==================== PISTOL ==================== -->

	<ThingDef ParentName="BaseHumanMakeableGun">
		<defName>ABG_Gun_SBPistol</defName>
		<label>advanced ballistic pistol</label>
		<description>A handy sidearm with low stopping power, making up for it in weight and compactness. This weapon is an improvement over industrial/modern designs with the use of more advanced, precise techniques and better materials.</description>
		<techLevel>Spacer</techLevel>
		<graphicData>
			<texPath>conventional/spacer/pistol</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<soundInteract>Interact_Autopistol</soundInteract>
		<thingSetMakerTags>
			<li>RewardStandardQualitySuper</li>
		</thingSetMakerTags>
		<statBases>
			<WorkToMake>10000</WorkToMake>
			<Mass>1.1</Mass>
			<RangedWeapon_Cooldown>0.36</RangedWeapon_Cooldown>
			<SightsEfficiency>0.7</SightsEfficiency>
			<ShotSpread>0.14</ShotSpread>
