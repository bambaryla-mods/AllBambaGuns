			<Bulk>1.80</Bulk>
		</statBases>
		<weaponTags>
			<li>SpacerGun</li>
			<li>CE_Sidearm</li>
			<li>CE_AI_BROOM</li>
			<li>CE_OneHandedWeapon</li>
		</weaponTags>
		<weaponClasses>
			<li>RangedLight</li>
		</weaponClasses>
		<tradeTags>
			<li>WeaponRanged</li>
		</tradeTags>
		<costList>
			<Steel>30</Steel>
			<Plasteel>5</Plasteel>
			<ComponentIndustrial>3</ComponentIndustrial>
		</costList>
		<recipeMaker>
			<researchPrerequisite>ABG_Research_AdvancedBallisticWeaponry</researchPrerequisite>
			<skillRequirements>
				<Crafting>5</Crafting>
			</skillRequirements>
			<displayPriority>700</displayPriority>
		</recipeMaker>
		<verbs>
			<li Class="CombatExtended.VerbPropertiesCE">
				<recoilAmount>2.50</recoilAmount>
				<verbClass>CombatExtended.Verb_ShootCE</verbClass>
